# =============================================================================
# trading-bot — environment template
# Copy to .env for local dev. NEVER commit .env. On Railway, set these as
# service-level variables.
# =============================================================================

# -- Mode -----------------------------------------------------------------
# "testnet" or "live". No default. Bot refuses to start if unset.
TRADING_MODE=testnet

# -- Database -------------------------------------------------------------
# Railway-provided DATABASE_URL is used as-is in production.
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tradingbot

# -- Delta Exchange India --------------------------------------------------
# Use the testnet pair while TRADING_MODE=testnet.
DELTA_TESTNET_API_KEY=
DELTA_TESTNET_API_SECRET=
DELTA_TESTNET_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_TESTNET_WS_URL=wss://socket-ind.testnet.deltaex.org

DELTA_LIVE_API_KEY=
DELTA_LIVE_API_SECRET=
DELTA_LIVE_BASE_URL=https://api.india.delta.exchange
DELTA_LIVE_WS_URL=wss://socket.india.delta.exchange

# -- Binance (public market data only — no auth needed) -------------------
BINANCE_REST_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com

# -- Zerodha Kite Connect (stocks) ----------------------------------------
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# -- Telegram alerts ------------------------------------------------------
# If unset, alert module no-ops (useful in dev/testnet).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -- Google Drive nightly mirror ------------------------------------------
# Service account JSON path; folder ID is the destination.
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_ID=

# -- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json   # "json" or "console"

# -- Safety ---------------------------------------------------------------
DAILY_DRAWDOWN_PCT=5.0          # % of equity; trip → kill switch ON
WEEKLY_DRAWDOWN_PCT=10.0
LIQUIDATION_DISTANCE_MIN_PCT=15.0  # auto-deleverage if closer
DRIFT_BPS_MAX=50                # delta vs binance price drift, bps
