.claude/settings.local.json


# Runtime state (Dhan token cache — a live 24h secret; never commit)
/state/

# Nightly archive output (core/export.py) — audit rows and the trade ledger.
# Operational data, not source: it belongs in Drive, and the Railway container
# that normally writes it has an ephemeral disk anyway. Committing it would put
# the audit log in git history and grow the repo without bound.
data/exports/
# Generated cache: Dhan's scrip master, refetched on demand and written by
# DhanData._load_universe. Committed by accident on 2026-08-14, which broke
# the VM's ff-only deploy for 15 minutes — the box keeps its own copy as an
# untracked file, and git refuses to overwrite one.
data/dhan_universe.json
# Same, for the F&O contract registry (Decision 036). Larger and far more
# perishable than the equity one — several MB, refetched every 12 hours as
# expiries roll — and the filename carries a digest of the underlying scope,
# so committing one would seed the VM with a truncated catalogue AND trip the
# same ff-only deploy break the line above records.
data/dhan_fno_universe*.json

# Agent skills installed by `npx skills add` (e.g. dhan-oss/dhanhq-skills).
# Reference material for whoever is driving the editor, not something the bot
# imports — the repo talks to Dhan through its own clients in src/brokers/dhan/,
# not the dhanhq SDK these skills assume. .claude/skills/ holds absolute-path
# symlinks into .agents/, which would land on the VM dangling, and skills-lock.json
# pins upstream commits that are a local install detail.
.agents/
.claude/skills/
skills-lock.json
