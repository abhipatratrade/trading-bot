{"nodes": [{"id": "src_dashboard_templates_bucket_bucket_detail", "label": "Bucket Detail Page", "file_type": "code", "source_file": "src/dashboard/templates/bucket.html", "source_location": "L1-L245", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_dashboard_templates_bucket_bucket_header", "label": "Bucket Detail Header", "file_type": "code", "source_file": "src/dashboard/templates/bucket.html", "source_location": "L5-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_dashboard_templates_bucket_money_panel", "label": "Bucket Money Panel", "file_type": "code", "source_file": "src/dashboard/templates/bucket.html", "source_location": "L21-L84", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_dashboard_templates_bucket_manual_run_form", "label": "Request Next-Tick Run Control", "file_type": "rationale", "source_file": "src/dashboard/templates/bucket.html", "source_location": "L73-L83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /buckets/{id}/run does NOT place an order from the web process. It only writes an audit row that the bot picks up on its next loop tick ('Logs an audit row. The bot processes it on the next loop tick.'). This keeps the dashboard out of the trading decision path and preserves the deterministic scanner-brain-allocator-safety-broker loop; the button is also disabled when the bucket is not enabled."}, {"id": "src_dashboard_templates_bucket_regime_table", "label": "Per-Symbol Regime Table", "file_type": "code", "source_file": "src/dashboard/templates/bucket.html", "source_location": "L86-L137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders one row per (bucket, symbol) regime snapshot with label, signed signal, model_version, staleness in minutes, and the full state-probability vector. An is_market row is badged 'fallback', exposing when a symbol had no own model and fell back to the market-level regime."}, {"id": "src_dashboard_templates_bucket_running_trades", "label": "Running Trades Table", "file_type": "code", "source_file": "src/dashboard/templates/bucket.html", "source_location": "L139-L167", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_dashboard_templates_bucket_scanning_strategies", "label": "Scanning-vs-Trading Strategy Table", "file_type": "code", "source_file": "src/dashboard/templates/bucket.html", "source_location": "L169-L194", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_dashboard_templates_bucket_recent_trades", "label": "Bucket Recent Trades Table", "file_type": "code", "source_file": "src/dashboard/templates/bucket.html", "source_location": "L196-L244", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_dashboard_templates_bucket_reconciler_fill_economics", "label": "Reconciler-Written Fill Economics", "file_type": "rationale", "source_file": "src/dashboard/templates/bucket.html", "source_location": "L197-L201", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fill price, traded amount and P&L columns are blank ('-') until the reconciler sweep backfills them roughly 5 minutes after a fill, so a fresh row showing no P&L is expected rather than a bug. P&L % is measured against traded notional, not margin: the reader must multiply by leverage to get the margin-relative return. pnl_kind is truncated to 6 chars as a provenance hint for how the P&L was derived."}], "edges": [{"source": "src_dashboard_templates_bucket_bucket_detail", "target": "src_dashboard_templates_base_base_layout", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/dashboard/templates/bucket.html", "source_location": "L1-L2", "weight": 1.0}, {"source": "src_dashboard_templat