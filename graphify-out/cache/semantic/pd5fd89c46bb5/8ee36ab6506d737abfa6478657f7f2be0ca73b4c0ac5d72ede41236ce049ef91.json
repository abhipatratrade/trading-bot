{"nodes": [{"id": "src_dashboard_templates_params_scanner_scanner_view", "label": "Scanner Params View", "file_type": "code", "source_file": "src/dashboard/templates/params_scanner.html", "source_location": "L1-L71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_dashboard_templates_params_scanner_filter_chain", "label": "Ordered Short-Circuit Filter Chain", "file_type": "rationale", "source_file": "src/dashboard/templates/params_scanner.html", "source_location": "L28-L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filters are applied in declared order and any failure short-circuits, dropping the symbol - so ordering is semantically load-bearing (cheap/most-rejecting filters belong first) and the view numbers each row with loop.index to make that order visible. An empty filter list means every eligible symbol passes through, not that scanning is off."}, {"id": "src_dashboard_templates_params_scanner_ranker", "label": "Ranker and universe_size Cutoff", "file_type": "concept", "source_file": "src/dashboard/templates/params_scanner.html", "source_location": "L8-L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Survivors of the filter chain are ranked by a single named ranker, and only the top universe_size symbols are handed to the strategies. universe_size is therefore the width of everything downstream (strategies, sizer, orders)."}], "edges": [{"source": "src_dashboard_templates_params_scanner_scanner_view", "target": "src_dashboard_templates_base_base_layout", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/dashboard/templates/params_scanner.html", "source_location": "L1-L2", "weight": 1.0}, {"source": "src_dashboard_templates_params_scanner_scanner_view", "target": "src_dashboard_templates__params_header_bucket_header", "relation": "calls", "confidence": "EXTRACTED", "confide