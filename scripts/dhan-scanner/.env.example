# --- Interim Dhan Scanner: Blasting Momentum Swing v1 (3x MTF) ---
# Copy to .env and fill in. NEVER commit the real .env (house rule 5).

# sandbox = Dhan testnet (orders simulated) | live = real money
# (mirrors house rule 6: mode is an explicit env var, no default to live)
DHAN_ENV=sandbox

# Market data ALWAYS uses the live data API (sandbox has no market data).
# Same token the Backtesting Engine uses.
#
# NOTE: since 2025-10-01 Dhan caps directly-generated tokens at 24h (SEBI rule),
# so a static token here goes stale mid-cycle. Either regenerate it daily, OR
# leave it and set the auto-refresh block below (DHAN_PIN + DHAN_TOTP_SECRET +
# DHAN_CLIENT_ID) -- then each run mints a fresh 24h token via TOTP.
DHAN_ACCESS_TOKEN=your_live_access_token_here

# --- Auto-refresh (recommended for scheduled runs) ---
# If all three are set, the runner mints a fresh 24h LIVE data token on startup
# and ignores the (stale) DHAN_ACCESS_TOKEN above. DHAN_PIN is your Dhan login/
# trading PIN; DHAN_TOTP_SECRET is the base32 secret shown when you enable TOTP
# in the DevPortal (Optional Settings -> Set-up TOTP). Leave blank to disable.
DHAN_PIN=your_dhan_login_pin_here
DHAN_TOTP_SECRET=your_base32_totp_secret_here

# Sandbox (testnet) credentials -- developer.dhanhq.co -> Sandbox tab.
# These are DevPortal-issued and are NOT auto-refreshed by the runner; refresh
# them manually if/when they expire.
DHAN_SANDBOX_ACCESS_TOKEN=your_sandbox_token_here
DHAN_SANDBOX_CLIENT_ID=your_sandbox_client_id_here

# Live account client id. Required for auto-refresh (the data token is tied to
# the live account) AND for live order placement when DHAN_ENV=live.
DHAN_CLIENT_ID=your_live_client_id_here

# Indicators + scrip master are imported from the Backtesting Engine so the
# live numbers are byte-identical to the backtest.
BACKTEST_ENGINE_DIR=D:/Claude_TVconnect2/Backtesting Engine

# Strategy parameters (v1 -- mirror src/strategies/swing/indian/scanner.yaml)
POSITION_SIZE=10000
MAX_POSITIONS=5
MAX_DAYS=30

# MTF = 3x broker funding (user's chosen mode). Non-MTF-approved scrips
# (common outside large caps, esp. BSE-only names) reject MTF orders;
# MTF_FALLBACK_CNC=true retries those as CNC (1x delivery).
PRODUCT_TYPE=MTF
MTF_FALLBACK_CNC=true
